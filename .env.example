# SIREN Environment Configuration
# Copy this file to .env and fill in the values

# Server configuration
HOST=0.0.0.0
PORT=7860

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Default task difficulty (easy, medium, hard)
DEFAULT_TASK_ID=easy

# Random seed for reproducible episodes (leave empty for random)
# SEED=42

# LLM agent configuration (required for OpenEnv submission)
# API_BASE_URL=https://api-inference.huggingface.co/v1
# MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
# HF_TOKEN=hf_your_token_here
